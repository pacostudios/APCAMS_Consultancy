# Copy to .env.local and fill in.

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the site (http://localhost:3000 in development)
BETTER_AUTH_URL=http://localhost:3000

# SQLite file (defaults to ./data/app.db)
DATABASE_PATH=./data/app.db

# Business timezone for all dates shown and entered
BUSINESS_TIMEZONE=Australia/Sydney

# First admin account, created by `npm run seed`
ADMIN_EMAIL=admin@apcams.com.au
ADMIN_PASSWORD=
ADMIN_NAME=APCAMS Admin
