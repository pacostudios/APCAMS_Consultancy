# Copy to .env.local and fill in.

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the site (http://localhost:3000 in development)
BETTER_AUTH_URL=http://localhost:3000

# SQLite file (defaults to ./data/app.db)
DATABASE_PATH=./data/app.db

# Business timezone for all dates shown and entered
BUSINESS_TIMEZONE=Australia/Sydney

# First admin account, created by `npm run seed`
ADMIN_EMAIL=admin@alchemetanoia.com
ADMIN_PASSWORD=
ADMIN_NAME=Alchemetanoia Admin

# Email: set EITHER the SMTP block (e.g. Gmail) OR RESEND_API_KEY.
# With neither, emails are printed to the server console instead.
EMAIL_FROM="Alchemetanoia Consultancy <no-reply@alchemetanoia.com>"

# SMTP. For Gmail: host smtp.gmail.com, port 465, your Gmail address, and a 16-character
# App Password (Google Account → Security → 2-Step Verification → App passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Resend (resend.com) — used only when SMTP_HOST is empty
RESEND_API_KEY=

# Zoom Server-to-Server OAuth app (marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth).
# Scopes: meeting:write:meeting:admin, meeting:update:meeting:admin, meeting:delete:meeting:admin
# Without these, bookings still work but have no Zoom link until one is added in the admin dashboard.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Zoom user (email or id) who hosts the meetings; "me" = the account owner
ZOOM_HOST_USER=me

# Stripe (dashboard.stripe.com → Developers → API keys). Use sk_test_… while testing, sk_live_… in production.
# Without a key, paid bookings are confirmed without payment (development only).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your-site>/api/stripe/webhook (starts with whsec_).
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints one.
STRIPE_WEBHOOK_SECRET=
